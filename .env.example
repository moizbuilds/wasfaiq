# Copy this to .env and fill in your keys

# Supabase — get from Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# These are SERVER ONLY — never prefix with VITE_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Apify — get from apify.com → Settings → Integrations
APIFY_TOKEN=your-apify-token

# JAIS — get from ai71.ai
JAIS_API_KEY=your-jais-key

# Anthropic — get from console.anthropic.com (used as JAIS fallback)
ANTHROPIC_API_KEY=your-anthropic-key
